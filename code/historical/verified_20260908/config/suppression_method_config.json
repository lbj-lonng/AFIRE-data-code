{
  "version": "bem_hbmi_pilot_v2",
  "seed": 2026090801,
  "pseudo_suppression": {
    "visible_count_lower": 10,
    "visible_count_upper": 19,
    "minimum_cells_per_group": 2,
    "draws_per_group": 100,
    "bootstrap_replicates": 2000
  },
  "hierarchical_imputation": {
    "outcome": "copd",
    "years_for_rate_model": [2006, 2020],
    "boundaries": [[0, 9], [1, 9]],
